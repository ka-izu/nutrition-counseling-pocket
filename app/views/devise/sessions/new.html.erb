<div class="flex items-center justify-center mx-auto max-w-5xl px-6 my-16">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-center text-base-content mb-6">
      <%= t("devise.sessions.new.title", default: "ログイン") %>
    </h2>

    <%= form_for(resource,
          as: resource_name,
          url: session_path(resource_name),
          html: { class: "space-y-5" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- メールアドレス -->
      <div>
        <%= f.label :email, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: t("devise.shared.placeholders.email"),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md
                      focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- パスワード -->
      <div>
        <%= f.label :password, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.password_field :password,
              autocomplete: "current-password",
              placeholder: t("devise.shared.placeholders.password"),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md
                      focus:outline-none focus:ring focus:border-accent" %>
      </div>
<%
=begin
%>
      <!-- Remember me -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
          <%= f.label :remember_me, class: "text-sm text-base-content" %>
        </div>
      <% end %>
<%
=end
%>

      <!-- Submit -->
      <div class="flex justify-center my-8">
        <%= f.submit t("devise.sessions.new.sign_in", default: "ログイン"),
              class: "btn btn-primary w-32 text-base font-medium" %>
      </div>
    <% end %>

    <div class="divider"></div>

    <div class="text-center space-y-2">
      <%= link_to "アカウントをお持ちでない方はこちら",
            new_registration_path(resource_name),
            class: "text-sm hover:underline" %>
<%
=begin
%>
<!-- TODO: 本リリースで実装 -->
      <%= link_to "パスワードをお忘れの方はこちら",
            new_password_path(resource_name),
            class: "block text-sm hover:underline" %>
<%
=end
%>
    </div>
  </div>
</div>
