<div class="flex items-center justify-center mx-auto max-w-5xl px-6 my-16">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-center text-base-content mb-6">
      <%= t("devise.sessions.new.title", default: "ログイン") %>
    </h2>

    <%= form_for(resource,
          as: resource_name,
          url: session_path(resource_name),
          html: { class: "space-y-5" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- メールアドレス -->
      <div>
        <%= f.label :email, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: t("devise.shared.placeholders.email"),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md
                      focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- パスワード -->
      <div>
        <%= f.label :password, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.password_field :password,
              autocomplete: "current-password",
              placeholder: t("devise.shared.placeholders.password"),
              class: "w-full px-3 py-2 border border-gray-300 rounded-md
                      focus:outline-none focus:ring focus:border-accent" %>
      </div>
<%
=begin
%>
      <!-- Remember me -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center gap-2">
          <%= f.check_box :remember_me, class: "checkbox checkbox-sm" %>
          <%= f.label :remember_me, class: "text-sm text-base-content" %>
        </div>
      <% end %>
<%
=end
%>

      <!-- Submit -->
      <div class="flex justify-center my-6">
        <%= f.submit t("devise.sessions.new.sign_in", default: "ログイン"),
              class: "btn btn-primary w-32 text-base font-medium" %>
      </div>
    <% end %>

    <div class="divider my-6">または</div>

    <%= button_to user_google_oauth2_omniauth_authorize_path,
      data: { turbo: false },
      class: "w-full flex justify-center items-center
              btn bg-white text-base border border-secondary/50 rounded-md
              transition duration-150 ease-in-out
              hover:bg-gray-50 hover:shadow-sm
              active:scale-98" do %>
      <svg aria-label="Google logo" width="24" height="24" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
        <g>
          <path fill="#34a853" d="M153 292c30 82 118 95 171 60h62v48A192 192 0 0190 341"></path>
          <path fill="#4285f4" d="m386 400a140 175 0 0053-179H260v74h102q-7 37-38 57"></path>
          <path fill="#fbbc02" d="m90 341a208 200 0 010-171l63 49q-12 37 0 73"></path>
          <path fill="#ea4335" d="m153 219c22-69 116-109 179-50l55-54c-78-75-230-72-297 55"></path>
        </g>
      </svg>
      <span class="font-roboto font-medium">
        Google でログイン
      </span>
    <% end %>

    <div class="text-center mt-4">
      <%= link_to "アカウントをお持ちでない方はこちら",
            new_registration_path(resource_name),
            class: "text-sm hover:underline" %>
<%
=begin
%>
<!-- TODO: 本リリースで実装 -->
      <%= link_to "パスワードをお忘れの方はこちら",
            new_password_path(resource_name),
            class: "block text-sm hover:underline" %>
<%
=end
%>
    </div>
  </div>
</div>
