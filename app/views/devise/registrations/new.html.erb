<section class="flex items-center justify-center mx-auto max-w-5xl px-6 my-16">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-2xl font-bold text-center text-base-content mb-6"><%= t('devise.registrations.new.title') %></h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- ユーザー名 -->
      <div>
        <%= f.label :name, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.text_field :name,
              placeholder: t('devise.shared.placeholders.name'),
              class: "w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div> 

      <!-- メールアドレス -->
      <div>
        <%= f.label :email, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.email_field :email,
              placeholder: t('devise.shared.placeholders.email'),
              autofocus: true,
              autocomplete: "email",
              class: "w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Password -->
      <div>
        <div class="flex items-center justify-start mb-1">
          <%= f.label :password, class: "block text-base font-medium text-base-content" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-base-content/50 ml-2"><%= t('devise.shared.minimum_password_length', count: @minimum_password_length) %></span>
          <% end %>
        </div>
        <%= f.password_field :password,
              placeholder: t('devise.shared.placeholders.password'),
              autocomplete: "new-password",
              class: "w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= f.label :password_confirmation, class: "block text-base font-medium text-base-content mb-1" %>
        <%= f.password_field :password_confirmation,
              placeholder: t('devise.shared.placeholders.password_confirmation'),
              autocomplete: "new-password",
              class: "w-full px-3 py-2 border border-base-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Submit -->
      <div class="flex justify-center my-8">
        <%= f.submit t('devise.registrations.new.sign_up'),
              class: "btn btn-primary w-32 text-base font-medium" %>
      </div>
    <% end %>

    <div class="divider"></div>
    <div class="text-center">
      <%= link_to "すでにアカウントをお持ちの方はログインへ",
            new_session_path(resource_name),
            class: "text-sm hover:underline" %>
    </div>
  </div>
</section>
