<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-md bg-white p-8 rounded-lg shadow-md">
    <h2 class="text-3xl font-bold text-center text-base-content mb-6">新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- ユーザー名 -->
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-base-content mb-1" %>
        <%= f.text_field :name,
              class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div> 

      <!-- メールアドレス -->
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-base-content mb-1" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Password -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <%= f.label :password, class: "block text-sm font-medium text-base-content" %>
          <% if @minimum_password_length %>
            <span class="text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</span>
          <% end %>
        </div>
        <%= f.password_field :password,
              autocomplete: "new-password",
              class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Password Confirmation -->
      <div>
        <%= f.label :password_confirmation, class: "block text-sm font-medium text-base-content mb-1" %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring focus:border-accent" %>
      </div>

      <!-- Submit -->
      <div class="flex justify-center my-8">
        <%= f.submit "登録",
              class: "btn btn-primary w-32 text-base font-medium" %>
      </div>
    <% end %>

    <div class="divider"></div>
    <div class="text-center">
      <%= link_to "すでにアカウントをお持ちの方はログインへ",
            new_user_session_path,
            class: "text-sm hover:underline" %>
    </div>
  </div>
</div>
