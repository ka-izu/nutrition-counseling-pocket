<div class="w-full bg-base-100 text-secondary">
  <% if user_signed_in? %>
    <div class="m-16 rounded-box p-8 bg-base-100">

      <!-- Welcome -->
      <div class="mb-8">
        <h1 class="text-2xl font-bold mb-2">
          ようこそ、栄養指導ポケットへ
        </h1>
        <p class="text-secondary/70 text-sm">
          こんにちは、<%= current_user.name %>さん。
          栄養指導を、安心して取り組むための準備をしましょう！
        </p>
      </div>

      <!-- 今日できること -->
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-base">
              指導資料・メモを確認
            </h2>
            <p class="text-sm text-secondary/70">
              疾患別に整理された資料や、
              これまでのメモをすぐに確認できます。
            </p>
            <%= link_to library_diseases_path, class: "btn btn-primary mt-4" do %>
              ライブラリを開く
            <% end %>
          </div>
        </div>

        <div class="card bg-base-200">
          <div class="card-body">
            <h2 class="card-title text-base">
              指導内容のヒントを探す
            </h2>
            <p class="text-sm text-secondary/70">
              患者の状態に応じた
              「伝え方」のヒントを確認できます。
            </p>
            <%= link_to "#", class: "btn btn-outline mt-4" do %>
              ヒントを見る
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% else %>
  <!-- ===================== -->
  <!-- HERO -->
  <!-- ===================== -->
  <section class="mx-auto max-w-6xl px-6 min-h-screen
                  grid md:grid-cols-2
                  gap-6 md:gap-8 lg:gap-10
                  items-center mb-16">
    <div>
      <h1 class="text-4xl font-bold leading-snug mb-4">
        限られた時間でも、<br />
        <span class="text-primary">
          迷わず伝えられる栄養指導を
        </span>
      </h1>

      <span class="badge badge-soft badge-primary p-4 mb-8">
        病院・クリニック・薬局
      </span>

      <p class="text-base text-secondary/70 mb-8 leading-relaxed">
        栄養指導ポケットは、<br />
        医療の現場で栄養アドバイスに関わる人のための、<br />
        栄養指導ナレッジ管理 ＆ クイックアドバイスツールです
      </p>

      <div class="flex flex-wrap gap-4">
        <%= link_to new_user_registration_path, class: "btn btn-primary rounded-4xl px-8" do %>
          はじめてみる
        <% end %>
      </div>
    </div>

    <div class="md:justify-self-end justify-self-center">
      <div class="mockup-browser border bg-base-200 w-full max-w-md shadow-lg">
        <div class="mockup-browser-toolbar">
          <div class="input">栄養指導ポケット</div>
        </div>
        <div class="bg-base-100">
          <%= image_tag "hero_mock.png",
            alt: "栄養指導ポケット サービスイメージ",
            class: "w-full h-auto" %>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== -->
  <!-- 課題共感 -->
  <!-- ===================== -->
  <section>
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-2xl font-bold leading-relaxed mb-6">
        このようなお悩みを解決します
      </h2>

      <div class="mx-auto mt-4 mb-6 h-1 w-16 bg-primary rounded"></div>
    </div>

    <div class="flex justify-center gap-x-20 flex-wrap md:flex-nowrap gap-10 md:gap-20">
      <!-- 声 1 -->
      <div class="flex flex-col items-center gap-4 w-64 shrink-0 mb-4">
        <!-- 吹き出し -->
        <div class="relative bg-base-300 text-secondary text-base leading-relaxed
                    px-4 py-3 rounded-xl text-center w-64 h-32
                    flex items-center justify-center">
          患者情報が揃っていない中で、
          その場対応になってしまう…
          納得感のある説明ができたか不安になる

          <!-- とんがり -->
          <div class="absolute left-1/2 -bottom-2 -translate-x-1/2
                      w-0 h-0
                      border-l-8 border-r-8 border-t-8
                      border-l-transparent border-r-transparent
                      border-t-base-300">
          </div>
        </div>

        <!-- 人物イラスト -->
        <div class="w-28 opacity-90">
          <%= image_tag "person_1.svg",
                alt: "悩んでいる栄養士",
                class: "w-full h-auto" %>
        </div>
      </div>

      <!-- 声 2 -->
      <div class="flex flex-col items-center gap-4 w-64 shrink-0 mb-4">
        <!-- 吹き出し -->
        <div class="relative bg-base-300 text-secondary text-base leading-relaxed
                    px-4 py-3 rounded-xl text-center w-64 h-32
                    flex items-center justify-center">
          その場対応では、用意していた資料も
          結局うまく使えずに終わることが多い

          <!-- とんがり -->
          <div class="absolute left-1/2 -bottom-2 -translate-x-1/2
                      w-0 h-0
                      border-l-8 border-r-8 border-t-8
                      border-l-transparent border-r-transparent
                      border-t-base-300">
          </div>
        </div>

        <div class="w-28 opacity-90">
          <%= image_tag "person_2.svg",
                alt: "迷っている指導者",
                class: "w-full h-auto" %>
        </div>
      </div>

      <!-- 声 3 -->
      <div class="flex flex-col items-center gap-4 w-64 shrink-0">
        <!-- 吹き出し -->
        <div class="relative bg-base-300 text-secondary text-base leading-relaxed
                    px-4 py-3 rounded-xl text-center w-64 h-32
                    flex items-center justify-center">
          「この伝え方でよかったのか」と、
          あとから迷うことがある…
          なんとなく、指導の場が不安になる
          <!-- とんがり -->
          <div class="absolute left-1/2 -bottom-2 -translate-x-1/2
                      w-0 h-0
                      border-l-8 border-r-8 border-t-8
                      border-l-transparent border-r-transparent
                      border-t-base-300">
          </div>
        </div>

        <div class="w-28 opacity-90">
          <%= image_tag "person_3.svg",
                alt: "困っている指導者",
                class: "w-full h-auto" %>
        </div>
      </div>

    </div>

  </section>

  <!-- ===================== -->
  <!-- 機能紹介 -->
  <!-- ===================== -->
  <section
    id="introduction"
    class="py-28 bg-primary/20 mt-28">
    <div class="container mx-auto px-6">

      <!-- セクションヘッダー -->
      <div class="text-center max-w-3xl mx-auto mb-20">
        <h2 class="text-2xl font-bold leading-relaxed mb-6">
          栄養指導ポケットでできること
        </h2>

        <div class="mx-auto mt-4 mb-6 h-1 w-16 bg-primary rounded"></div>
      </div>

      <!-- 機能一覧 -->
      <div class="grid md:grid-cols-3 gap-8">

        <!-- 機能1 -->
        <div class="card bg-base-100 shadow-lg max-w-xs mx-auto">
          <figure class="px-6 pt-6 h-50 flex items-center justify-center">
            <%= image_tag "knowledge.svg",
              alt: "疾患別ナレッジ管理 イメージ",
              class: "rounded-lg" %>
          </figure>
          <div class="card-body">
            <h3 class="card-title text-base">
              疾患別ナレッジ管理
            </h3>
            <p class="text-sm text-secondary/70 leading-relaxed">
              疾患別に指導資料（画像・PDF）や
              ナレッジメモを整理。
              自分専用の指導手引として蓄積し、
              「いつもの指導」をすぐに再現できます。
            </p>
          </div>
        </div>

        <!-- 機能2 -->
        <div class="card bg-base-100 shadow-lg max-w-xs mx-auto">
          <figure class="px-6 pt-6 h-50 flex items-center justify-center">
            <%= image_tag "search.svg",
              alt: "指導媒体の一元管理 イメージ",
              class: "rounded-lg" %>
          </figure>
          <div class="card-body">
            <h3 class="card-title text-base">
              検索・タグ対応の指導媒体管理
            </h3>
            <p class="text-sm text-secondary/70 leading-relaxed">
              整理した資料は、
              タグ付けや検索機能により、必要な情報をすぐ提示できます。
            </p>
          </div>
        </div>

        <!-- 機能3 -->
        <div class="card bg-base-100 shadow-lg max-w-xs mx-auto">
          <figure class="px-6 pt-6 h-50 flex items-center justify-center">
            <%= image_tag "counseling.svg",
              alt: "クイックアドバイス イメージ",
              class: "rounded-lg" %>
          </figure>
          <div class="card-body">
            <h3 class="card-title text-base">
              患者特性に応じたクイックアドバイス
            </h3>
            <p class="text-sm text-secondary/70 leading-relaxed">
              疾患・生活習慣・性格傾向を選ぶだけで、
              その患者さんに合った
              一言アドバイスのヒントをAIが提案します。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== -->
  <!-- CTA -->
  <!-- ===================== -->
  <section class="text-center py-24">
    <h2 class="text-2xl font-bold mb-6">
      栄養指導を、もっと安心できる時間へ
    </h2>
    <p class="text-secondary/70 mb-8">
      「何を伝えよう」をサポートし、コミュニケーションに集中できる時間を
    </p>
    <%= link_to new_user_registration_path, class: "btn btn-primary btn-wide rounded-4xl" do %>
      はじめてみる
    <% end %>
  </section>
  <% end %>
</div>
