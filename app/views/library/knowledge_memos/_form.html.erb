<%= form_with model: knowledge_memo,
              url: form_url,
              local: true do |f| %>

  <% if knowledge_memo.errors.any? %>
    <div class="mb-6 border border-l-4 rounded-sm border-error bg-error/10 p-4 text-error">
      <ul class="list-disc pl-5">
        <% knowledge_memo.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white pt-8 pb-10 px-10 rounded-xl shadow-lg space-y-6 max-w-xl">

    <!-- =========================
         タイトル
    ========================== -->
    <div>
      <%= f.label :title,
            class: "block text-sm font-medium mb-1" do %>
        <%= KnowledgeMemo.human_attribute_name(:title) %>
        <span class="text-error ml-1">*</span>
      <% end %>

      <%= f.text_field :title,
            placeholder: "タイトルを入力",
            class: "w-full border rounded-sm p-2 text-sm
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <!-- =========================
         コンテンツ
    ========================== -->
    <div>
      <%= f.label :content, class: "block text-sm font-medium mb-1" %>

      <%= f.text_area :content,
            rows: 8,
            placeholder: "メモ内容を入力",
            class: "w-full border rounded-sm p-2 text-sm
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <!-- =========================
         保存
    ========================== -->
    <div class="flex justify-center pt-6">
      <%= f.submit nil,
            class: "btn btn-primary text-base px-8" %>
    </div>

  </div>
<% end %>
