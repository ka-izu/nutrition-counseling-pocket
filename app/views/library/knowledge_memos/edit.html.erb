<turbo-frame id="memo_detail">
  <div class="card bg-base-100 shadow rounded-sm">
    <div class="card-body">

      <%= form_with model: @knowledge_memo,
          url: library_disease_knowledge_memo_path(@knowledge_memo.disease, @knowledge_memo),
          method: :patch,
          class: "space-y-4" do |f| %>

        <!-- タイトル -->
        <div class="form-control">
          <label class="label">
            <span class="label-text">タイトル</span>
          </label>
          <%= f.text_field :title,
                class: "input input-bordered w-full focus:input-primary" %>
        </div>

        <!-- 内容 -->
        <div class="form-control">
          <label class="label">
            <span class="label-text">内容</span>
          </label>
          <%= f.text_area :content,
                rows: 6,
                class: "textarea textarea-bordered w-full focus:textarea-primary" %>
        </div>

        <!-- アクション -->
        <div class="flex justify-between items-center mt-2">

          <!-- 左：キャンセル -->
          <%= link_to "キャンセル",
              library_disease_knowledge_memo_path(@knowledge_memo.disease, @knowledge_memo),
              data: { turbo_frame: "memo_detail" },
              class: "btn btn-ghost btn-sm" %>

          <!-- 右：保存 -->
          <%= f.submit "保存",
                class: "btn btn-primary btn-sm px-6" %>

        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
