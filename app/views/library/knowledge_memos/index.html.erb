<section class="mx-auto max-w-6xl px-6 my-16">
  <!-- タイトル -->
  <h1 class="text-xl font-bold mb-4">
    <%= @disease.name %>
  </h1>

  <!-- タブ -->
  <%= render layout: "library/diseases/tabs" do %>

    <!-- 操作エリア：左 追加 / 右 検索 -->
    <div class="flex flex-col sm:flex-row
                sm:items-center sm:justify-between
                gap-4 mb-12">
      <!-- 左：新規追加 -->
      <%= link_to new_library_disease_teaching_material_path(@disease),
            class: "btn btn-primary" do %>
        <%= render "shared/icons/plus" %>
        新しいアイテムを追加
      <% end %>

<%
=begin
%>
      <!-- 右：検索 -->
      <div class="relative w-full max-w-xs">
        <%= render "search_form", q: @q, url: library_disease_teaching_materials_path %>

        <% if params[:q].present? %>
          <%= link_to t("library.teaching_materials.actions.clear_search"),
                library_disease_teaching_materials_path,
                class: "absolute right-0 -bottom-5 link link-primary text-xs" %>
        <% end %>
      </div>
<%
=end
%>
    </div>

    <div class="flex gap-6">
      <div class="w-1/2 space-y-2">
        <% @knowledge_memos.each do |memo| %>
        <div class="card cursor-pointer transition rounded-sm
          <%= memo == @selected_memo ?
              'bg-base-300
                text-base-content
                shadow-sm'
              :
              'bg-base-100
                transition-all
                duration-150
                ease-in-out
                hover:shadow-sm
                hover:bg-base-200
                hover:scale-102
                active:scale-98
                cursor-pointer'
          %>">
            <div class="card-body p-4 relative">
              <div class="flex items-center gap-2">
                <%= render "shared/icons/bars-3-bottom-left" %>

                <h2 class="card-title text-sm">
                  <%= memo.title %>
                </h2>
              </div>

              <p class="text-xs text-gray-500 line-clamp-2">
                <%= memo.content %>
              </p>

              <p class="text-xs opacity-40 text-right">
                <%= memo.updated_at.strftime("%m/%d %H:%M") %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
      <div class="w-1/2 pl-4">
        <div class="card bg-base-100 rounded-sm shadow">
          <div class="card-body">
            <% if @selected_memo %>
              <h2 class="text-lg font-bold mb-2">
                <%= @selected_memo.title %>
              </h2>

              <p class="whitespace-pre-wrap text-sm">
                <%= @selected_memo.content %>
              </p>

              <div class="mt-4">
                <%= link_to "編集", "#",
                    class: "btn btn-sm btn-outline" %>
              </div>
            <% else %>
              <p class="text-gray-400">メモを選択してください</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</section>
