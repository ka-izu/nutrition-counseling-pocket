<section class="mx-auto max-w-6xl px-6 my-16">
  <!-- タイトル -->
  <h1 class="text-xl font-bold mb-4">
    <%= @disease.name %>
  </h1>

  <!-- タブ -->
  <%= render layout: "library/diseases/tabs" do %>

    <!-- 操作エリア：左 追加 / 右 検索 -->
    <div class="flex flex-col sm:flex-row
                sm:items-center sm:justify-between
                gap-4 mb-12">
      <!-- 左：新規追加 -->
      <%= link_to new_library_disease_knowledge_memo_path(@disease),
            class: "btn btn-primary" do %>
        <%= render "shared/icons/plus" %>
        新しいメモを追加
      <% end %>

<%
=begin
%>
      <!-- 右：検索 -->
      <div class="relative w-full max-w-xs">
        <%= render "search_form", q: @q, url: library_disease_teaching_materials_path %>

        <% if params[:q].present? %>
          <%= link_to t("library.teaching_materials.actions.clear_search"),
                library_disease_teaching_materials_path,
                class: "absolute right-0 -bottom-5 link link-primary text-xs" %>
        <% end %>
      </div>
<%
=end
%>
    </div>

<div class="flex gap-6">
  <div class="w-1/2 space-y-2">
    <% @knowledge_memos.each do |memo| %>
      <%= link_to library_disease_knowledge_memo_path(@disease, memo),
          data: { turbo_frame: "memo_detail" } do %>
<%
=begin
%>
        <div class="card cursor-pointer transition rounded-sm mb-2
          <%= memo.id.to_s == @selected_memo&.id.to_s ?
              'bg-base-300 text-base-content shadow-sm' :
              'bg-base-100 transition-all duration-150 ease-in-out hover:shadow-sm hover:bg-base-200 hover:scale-102 active:scale-98' %>">
<%
=end
%>
        <div class="card cursor-pointer transition rounded-sm mb-2 bg-base-100 transition-all duration-150 ease-in-out hover:shadow-sm hover:bg-base-200 hover:scale-102 active:scale-98">
          <div class="card-body p-4 relative">
            <div class="flex items-center gap-2 min-w-0">
              <%= render "shared/icons/bars-3-bottom-left" %>

              <h2 class="card-title text-base-content text-sm flex-1 min-w-0">
                <span class="truncate block w-full">
                  <%= memo.title %>
                </span>
              </h2>
            </div>

            <p class="text-xs text-base-content/70 line-clamp-2 break-words">
              <%= memo.content %>
            </p>

            <p class="text-xs text-base-content/40 text-right">
              <%= l(memo.updated_at, format: :short) %>
            </p>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="w-1/2 pl-4">
    <turbo-frame id="memo_detail">
      <%= render "detail", memo: @selected_memo %>
    </turbo-frame>
  </div>
</div>
  <% end %>
</section>
