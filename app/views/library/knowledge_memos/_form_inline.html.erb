<div class="card bg-base-100 shadow rounded-sm">
  <div class="card-body">

    <% if knowledge_memo.errors.any? %>
      <div class="mb-6 text-error">
        <ul>
          <% knowledge_memo.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: knowledge_memo,
        url: library_disease_knowledge_memo_path(knowledge_memo.disease, knowledge_memo),
        method: :patch do |f| %>

      <%= f.text_field :title, class: "input w-full mb-2" %>
      <%= f.text_area :content, rows: 6, class: "textarea w-full mb-4" %>

      <div class="flex justify-between">

        <!-- キャンセル -->
        <%= link_to "キャンセル",
            library_disease_knowledge_memo_path(knowledge_memo.disease, knowledge_memo),
            data: { turbo_frame: "memo_detail" },
            class: "btn btn-ghost btn-sm" %>

        <!-- 保存 -->
        <%= f.submit "保存",
              class: "btn btn-primary btn-sm" %>

      </div>

    <% end %>
  </div>
</div>
