<% @teaching_materials.each do |tm| %>
  <li
    class="flex items-center justify-between
           px-3 py-2 text-sm
           cursor-pointer
           border-b last:border-b-0 border-base-200
           hover:bg-base-200
           transition-colors duration-100"
    role="option"
    data-autocomplete-value="<%= tm.title %>"
    data-autocomplete-label="<%= tm.title %>">

    <!-- タイトル -->
    <span class="truncate">
      <%= tm.title %>
    </span>
  </li>
<% end %>
