<% @autocomplete_list.each do |item| %>
  <li
    class="flex items-center justify-between
           px-3 py-2 text-sm
           cursor-pointer
           border-b last:border-b-0 border-base-200
           hover:bg-base-200
           transition-colors duration-100"
    role="option"
    data-autocomplete-value="<%= item %>"
    data-autocomplete-label="<%= item %>">

    <!-- タイトル -->
    <span class="truncate">
      <%= item %>
    </span>
  </li>
<% end %>
