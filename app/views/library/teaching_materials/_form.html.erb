<%= form_with model: teaching_material,
              url: form_url,
              local: true do |f| %>

  <% if teaching_material.errors.any? %>
    <div class="mb-6 border border-l-4 rounded-sm border-error bg-error/10 p-4 text-error">
      <ul class="list-disc pl-5">
        <% teaching_material.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white pt-8 pb-10 px-10 rounded-xl shadow-lg space-y-6 max-w-xl">
    <!-- =========================
         タイトル
    ========================== -->
    <div>
      <%= f.label :title,
            class: "block text-sm font-medium text-base-content mb-1" do %>
        <%= TeachingMaterial.human_attribute_name(:title) %>
        <span class="text-error ml-1">*</span>
      <% end %>

      <%= f.text_field :title,
            placeholder: t(".placeholders.title"),
            class: "w-full border rounded-sm p-2 text-sm
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <!-- =========================
         説明
    ========================== -->
    <div>
      <%= f.label :description,
            class: "block text-sm font-medium text-base-content mb-1" %>

      <%= f.text_field :description,
            placeholder: t(".placeholders.description"),
            class: "w-full border rounded-sm p-2 text-sm
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary" %>
    </div>

    <!-- =========================
         疾患（複数選択 / badge表示）
    ========================== -->
    <div>
      <%= f.label :teaching_material_diseases,
            class: "block text-sm font-medium text-base-content mb-1" do %>
        <%= TeachingMaterial.human_attribute_name(:teaching_material_diseases) %>
        <span class="text-error ml-1">*</span>
      <% end %>

      <p class="text-xs text-base-content/60 mb-2">
        <%= t(".hints.diseases") %>
      </p>

      <div data-controller="multi-select" class="dropdown w-full">

        <!-- Select風ボタン -->
        <div tabindex="0"
             class="w-full border rounded-sm p-2
                    flex items-center justify-between cursor-pointer
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary">

          <!-- 左側：badge + placeholder -->
            <div class="flex items-center flex-wrap gap-2">
              <!-- badge -->
              <div class="flex flex-wrap gap-1"
                  data-multi-select-target="labels">
                <% teaching_material.diseases.each do |disease| %>
                  <span class="badge badge-primary badge-sm"
                        data-id="<%= disease.id %>">
                    <%= disease.name %>
                  </span>
                <% end %>
              </div>

              <!-- placeholder -->
              <span class="text-base-content/50 text-sm"
                    data-multi-select-target="placeholder">
                <%= t(".placeholders.teaching_material_diseases") %>
              </span>
            </div>

            <!-- 右側：▼アイコン -->
            <%= render "shared/icons/chevron-down", classes: "text-base-content/50 shrink-0"%>
        </div>

        <!-- Dropdown -->
        <ul tabindex="0"
            class="dropdown-content menu p-2 bg-base-100 shadow rounded-box w-full z-[1] mt-1">

          <% diseases.each do |disease| %>
            <li>
              <label class="flex justify-between items-center cursor-pointer">
                <span class="text-sm"><%= disease.name %></span>

                <input type="checkbox"
                       class="checkbox checkbox-sm"
                       value="<%= disease.id %>"
                       data-name="<%= disease.name %>"
                       data-action="multi-select#toggle"
                       <%= "checked" if teaching_material.disease_ids.include?(disease.id) %> />
              </label>
            </li>
          <% end %>
        </ul>

        <!-- hidden inputs -->
        <div data-multi-select-target="inputs">
          <!-- 空配列を明示的に送る -->
          <input type="hidden" name="teaching_material[disease_ids][]" value="">
          <% teaching_material.disease_ids.each do |id| %>
            <input type="hidden"
                   name="teaching_material[disease_ids][]"
                   value="<%= id %>">
          <% end %>
        </div>
      </div>
    </div>

    <!-- =========================
        画像アップロード
    ========================== -->
    <div data-controller="file-input">
      <%= f.label :document,
            class: "block text-sm font-medium text-base-content mb-1" do %>
        <%= TeachingMaterial.human_attribute_name(:document) %>
        <span class="text-error ml-1">*</span>
      <% end %>

      <p class="text-xs text-base-content/60 mb-2">
        <%= t(".hints.document") %>
      </p>

      <div
        class="w-full border rounded-sm
              border-base-300
              focus-within:outline-none
              focus-within:ring-2
              focus-within:ring-primary">
        <!-- ファイル選択UI -->
        <div class="flex items-center gap-3">

          <!-- ボタン風 -->
          <label
            class="inline-flex items-center gap-2
                  px-4 py-2 rounded-sm text-sm
                  bg-base-100
                  cursor-pointer
                  hover:bg-base-300
                  focus-within:outline-none
                  focus-within:ring-2
                  focus-within:ring-primary">

            <span><%= t(".buttons.select_file") %></span>

            <%= f.file_field :document,
                  class: "hidden",
                  accept: TeachingMaterial::ACCEPTED_CONTENT_TYPES.join(","),
                  data: { action: "file-input#change" } %>
          </label>

          <!-- ファイル名表示 -->
          <span
            class="text-sm text-base-content/50 truncate max-w-xs"
            data-file-input-target="filename"
            data-placeholder="<%= t('.placeholders.document') %>">
            <%= teaching_material.document.attached? ?
                  teaching_material.document.filename.to_s :
                  t(".placeholders.document") %>
          </span>
        </div>
      </div>
    </div>

    <!-- =========================
         タグ
    ========================== -->
    <div>
      <%= f.label :tag,
            class: "block text-sm font-medium text-base-content mb-1" %>

      <p class="text-xs text-base-content/60 mb-2">
        <%= t(".hints.tag") %>
      </p>

      <%= f.text_field :tag_names,
            placeholder: t(".placeholders.tag"),
            class: "w-full border rounded-sm p-2 text-sm
                    border-base-300
                    focus:outline-none focus:ring-2 focus:ring-primary" %>

    <!-- =========================
         保存ボタン
    ========================== -->
    <div class="flex justify-center pt-6">
      <%= f.submit nil,
            class: "btn btn-primary text-base px-8" %>
    </div>

  </div>
<% end %>
