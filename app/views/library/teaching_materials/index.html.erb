<section class="mx-auto max-w-6xl px-6 my-16">
  <!-- タイトル -->
  <h1 class="text-xl font-bold mb-4">
    <%= @disease.name %>
  </h1>

  <!-- タブ -->
  <%= render layout: "library/diseases/tabs" do %>
    <!-- 操作エリア：左 追加 / 右 検索 -->
    <div class="flex flex-col sm:flex-row
                sm:items-center sm:justify-between
                gap-4 mb-12">
      <!-- 左：新規追加 -->
      <%= link_to new_library_disease_teaching_material_path(@disease),
            class: "btn btn-primary" do %>
        <%= render "shared/icons/plus" %>
        新しいアイテムを追加
      <% end %>

      <!-- 右：検索 -->
      <div class="relative w-full max-w-xs">
        <%= render "search_form", q: @q, url: library_disease_teaching_materials_path %>

        <% if params[:q].present? %>
          <%= link_to t("library.teaching_materials.actions.clear_search"),
                library_disease_teaching_materials_path,
                class: "absolute right-0 -bottom-5 link link-primary text-xs" %>
        <% end %>
      </div>
    </div>

    <!-- 一覧 -->
    <div class="border-base-300 p-6 rounded-box">
      <% if @teaching_materials.any? %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <% @teaching_materials.each do |tm| %>
            <div
              class="card bg-base-100 shadow-sm flex flex-col h-full
                    hover:shadow-md hover:bg-base-200
                    transition cursor-pointer"
              data-controller="card-link"
              data-card-link-url-value="<%= url_for(tm.document) %>"
              data-card-link-target-value="<%= tm.pdf? ? '_blank' : '_self' %>"
              data-action="click->card-link#go">

              <!-- サムネイル -->
              <figure
                class="relative aspect-[4/3] w-full overflow-hidden bg-base-200"
                data-controller="thumbnail"
              >
                <!-- ローディング -->
                <div
                  class="absolute inset-0 flex items-center justify-center"
                  data-thumbnail-target="skeleton"
                >
                  <span class="skeleton w-full h-full block"></span>
                </div>

                <% if tm.thumbnail? %>
                  <%= image_tag tm.thumbnail,
                        class: "absolute inset-0 w-full h-full object-cover",
                        data: { action: "load->thumbnail#loaded" } %>
                <% else %>
                  <div class="absolute inset-0 flex items-center justify-center text-xs text-gray-500">
                    PDFを開く
                  </div>
                <% end %>
              </figure>

              <!-- 本文 -->
              <div class="card-body flex flex-col flex-1 p-3">
                <h2 class="card-title text-sm font-semibold">
                  <%= tm.title %>
                </h2>

                <% if tm.pdf? %>
                  <span class="absolute top-2 right-2 badge badge-secondary badge-sm">
                    PDF
                  </span>
                <% end %>

                <p class="text-xs text-base-content/80">
                  <%= tm.description %>
                </p>

                <!-- タグ -->
                <div class="flex flex-wrap gap-1 mt-2">
                  <% tm.tags.each do |tag| %>
                    <span class="badge badge-outline badge-primary badge-sm">
                      <%= tag.name %>
                    </span>
                  <% end %>
                </div>

                <!-- 操作 -->
                <div class="card-actions mt-auto justify-end gap-1">
                  <%= link_to edit_library_disease_teaching_material_path(@disease, tm),
                        class: "icon-btn",
                        title: "編集" do %>
                    <%= render "shared/icons/pencil" %>
                  <% end %>

                  <%= link_to library_disease_teaching_material_path(@disease, tm),
                        data: {
                          turbo_method: :delete,
                          turbo_confirm: "削除しますか？"
                        },
                        class: "icon-btn text-error",
                        title: "削除" do %>
                    <%= render "shared/icons/trash" %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% elsif params[:q].present? %>
        <!-- 検索中だが結果なし -->
        <p class="text-base-content/60 text-center py-12">
          <%= t(
          "library.teaching_materials.empty.no_result",
          keyword: params.dig(:q, :title_or_description_cont)
        ) %>
        </p>
      <% else %>
        <!-- 初期表示でまだ登録がない -->
        <p class="text-base-content/60 text-center py-12">
          <%= t("library.teaching_materials.empty.no_items") %>
        </p>
      <% end %>
    </div>
  <% end %>
</section>
