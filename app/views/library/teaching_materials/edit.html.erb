<div class="flex justify-center">
  <div class="w-full max-w-xl">
    <h1 class="text-xl font-bold mb-6">
      指導ツールを編集（<%= @disease.name %>）
    </h1>

    <%= render "form",
          teaching_material: @teaching_material,
          diseases: @diseases,
          form_url: library_disease_teaching_material_path(@disease),
          submit_label: "更新する" %>

    <div class="mb-4">
      <%= link_to "← 一覧に戻る",
        library_disease_teaching_materials_path(@disease),
        class: "text-sm text-gray-500 hover:underline" %>
    </div>
  </div>
</div>
