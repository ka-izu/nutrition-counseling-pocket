<section class="mx-auto max-w-5xl px-6 my-16">
  <div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-6">
      <h1 class="text-xl font-bold">疾患一覧</h1>
      <%= link_to "#",
                  class: "btn btn-primary" do %>
        <%= render "shared/icons/plus" %>
        新しい疾患を追加（準備中）
      <% end %>
    </div>

    <ul class="bg-base-100 rounded-box">
      <% @diseases.each do |disease| %>
        <li class="border-base-300 border-b first:border-t-1">
          <%= link_to library_disease_teaching_materials_path(disease),
                      class: "flex items-center gap-4 p-3 hover:bg-base-200 w-full block" do %>
            <%= render "shared/icons/document-text" %>
            <span class="font-medium"><%= disease.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

  </div>
</section>
