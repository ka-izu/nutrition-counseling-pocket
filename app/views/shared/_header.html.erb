<header class="navbar px-12 shadow-sm h-16">
  <!-- 左側：ロゴ＋サービス名 -->
  <div class="flex-1">
    <%= link_to root_path,
      class: "inline-flex items-center gap-3 hover:opacity-90 transition-opacity duration-200" do %>

      <%= image_tag "logo.png",
        alt: "栄養指導ポケット ロゴ",
        class: "h-8 w-auto object-contain" %>
      <span class="text-xl font-semibold text-primary">
        栄養指導ポケット
      </span>
    <% end %>
  </div>

  <!-- 中央：ナビゲーショングループ -->
  <div class="flex items-center mr-12">
    <%= link_to library_diseases_path,
      class: nav_link_class(library_diseases_path) do %>
      <%= render "shared/icons/book-open" %>
      <span>指導ライブラリ</span>
    <% end %>

    <%= link_to advice_path,
      class: "
        btn btn-ghost
        border-0 shadow-none
        hover:bg-transparent
        hover:text-primary
        focus:outline-none focus:ring-0
        active:bg-transparent
        flex items-center gap-2
      " do %>
      <%= render "shared/icons/light-bulb" %>
      <span>クイックアドバイス</span>
    <% end %>
  </div>

  <!-- 右側：ログインボタン -->
  <div class="flex-none">
    <div class="dropdown dropdown-end">
      <!-- トリガー：Heroicon -->
      <div
        tabindex="0"
        role="button"
        class="btn btn-circle"
      >
        <%= render "shared/icons/user" %>
      </div>
      <!-- Dropdown menu -->
      <ul
        tabindex="-1"
        class="menu menu-sm dropdown-content bg-base-100 rounded-sm z-10 mt-3 w-52 p-2 shadow"
      >
        <li>
          <%= link_to "マイページ（準備中）", "#", class: "text-sm py-3 px-4" %>
        </li>
        <li>
          <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm py-3 px-4" %>
        </li>
      </ul>
    </div>
  </div>
</header>
