<section class="mx-auto max-w-3xl px-6 my-16">
<div class="mb-10 flex items-center gap-3">
  <div class="text-2xl"><%= render "shared/icons/light-bulb" %></div>
  <div>
    <p class="text-sm text-base-content">
      患者情報を入力すると、栄養指導のヒントをAIが提案します
    </p>
  </div>
</div>

  <%= form_with url: advice_path, method: :post, local: true,
      data: {
        controller: "ai-loading",
        action: "submit->ai-loading#start turbo:submit-end->ai-loading#finish"
      } do %>

    <!-- 疾患 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">疾患名</label>

      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-2"
        data-controller="disease"
      >

        <% ["糖尿病","高血圧","脂質異常症","高尿酸血症","骨粗しょう症","低栄養"].each do |disease| %>
          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="disease"
              value="<%= disease %>"
              class="peer hidden"
              data-action="change->disease#toggle"
            >

            <div class="
              btn btn-outline btn-secondary btn-md rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-95
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= disease %>
            </div>
          </label>
        <% end %>

        <!-- その他 -->
        <label class="col-span-2 md:col-span-4 gap-2">
          <div data-controller="counter">
            <input
              type="text"
              name="disease_other"
              maxlength="50"
              data-action="input->counter#update"
              data-counter-target="input"
              placeholder="その他の場合は、疾患名を入力してください"
              class="
                input input-secondary input-md rounded-sm
                h-auto min-h-0 w-full
                px-2 py-2"
            >

            <p class="text-xs text-base-content/60 mt-1">
              <span data-counter-target="count">0</span> / 50文字
            </p>
          </div>
        </label>
      </div>
    </div>

    <!-- 食生活 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">食生活</label>

      <p class="text-xs text-base-content/60 mb-2">
        ※ 該当する項目を選択してください（3つまで）
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% [
          "野菜が少ない",
          "食事バランスが偏りがち",
          "揚げ物が多い",
          "脂っこい料理が多い",
          "甘いものをよく食べる",
          "間食が多い",
          "外食が多い",
          "朝食を食べない",
          "夕食が遅くなる",
          "味付けは濃いめが好み",
          "炭水化物が多い",
          "食事量が多い",
          "バランスよく食べている"
        ].each do |diet| %>

          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="diet[]"
              value="<%= diet %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-md rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= diet %>
            </div>
          </label>

        <% end %>

      </div>
    </div>

    <!-- 生活習慣 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">生活習慣</label>

      <p class="text-xs text-base-content/60 mb-2">
        ※ 該当する項目を選択してください（3つまで）
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% [
          "運動習慣が少ない",
          "定期的に運動している",
          "デスクワークが多い",
          "活動量が多い",
          "不規則な生活リズム",
          "夜勤がある",
          "睡眠時間が短い",
          "料理が苦手",
          "外食に頼ることが多い",
          "お酒をよく飲む",
          "タバコを吸う"
        ].each do |lifestyle| %>

          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="lifestyle[]"
              value="<%= lifestyle %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-md rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= lifestyle %>
            </div>
          </label>

        <% end %>

      </div>
    </div>

    <!-- 食事療法に関する関心 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">食事療法に関する関心</label>

      <div
        class="grid grid-cols-2 md:grid-cols-4 gap-2"
        data-controller="disease"
      >

        <% ["やりたくない","これからやってみたい","半年未満の継続あり","半年以上の継続あり"].each do |personality| %>
          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="personality"
              value="<%= personality %>"
              class="peer hidden"
              data-action="change->disease#toggle"
            >

            <div class="
              btn btn-outline btn-secondary btn-md rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= personality %>
            </div>
          </label>
        <% end %>
      </div>
    </div>

    <!-- 患者特性(フリーテキスト) -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">アドバイスに必要な患者特性</label>

        <p class="text-xs text-base-content/60 mb-2">
          ※ 個人を特定できる情報は入力しないでください
        </p>

        <div data-controller="counter">
          <input
            type="text"
            name="patient_context"
            maxlength="200"
            data-action="input->counter#update"
            data-counter-target="input"
            placeholder="（例）75歳、独居、塩分摂取が多い傾向"
            class="
              input input-secondary input-md rounded-sm
              h-auto min-h-0 w-full
              px-2 py-2"
          >

          <p class="text-xs text-base-content/60 mt-1">
            <span data-counter-target="count">0</span> / 200文字
          </p>
        </div>

      </div>
    </div>

    <p class="text-sm text-base-content/60 my-2 text-center">
      情報が多いほど、より具体的なアドバイスを提供できます
    </p>

    <div class="flex justify-center">
      <%= button_tag type: "submit",
        data: { ai_loading_target: "button" },
        class: "btn btn-primary w-sm rounded-full flex items-center gap-2" do %>
        アドバイスのヒントを確認する
      <% end %>
    </div>

    <p class="text-sm text-base-content/60 my-4 text-center">
      ※ AIが患者情報をもとにアドバイスのヒントを生成します<br>
      ※ 最終的な判断は管理栄養士の専門的判断を優先してください
    </p>
  <% end %>

  <div id="advice_result">
    <!-- AIリクエストの結果が表示される -->
  </div>
</section>
