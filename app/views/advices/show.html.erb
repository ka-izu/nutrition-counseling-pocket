<section class="mx-auto max-w-5xl px-6 my-16">
  <%= form_with url: advice_path, method: :post, local: true do %>

    <!-- 疾患 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">
        疾患名 <span class="badge badge-error badge-sm">必須</span>
      </label>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% ["糖尿病","高血圧","脂質異常症","高尿酸血症","骨粗しょう症","低栄養"].each do |disease| %>
          <label class="cursor-pointer">
            <input
              type="radio"
              name="disease"
              value="<%= disease %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-sm rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-95
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= disease %>
            </div>
          </label>
        <% end %>

        <!-- その他 -->
        <label class="cursor-pointer col-span-2 md:col-span-4 flex gap-2 items-center">
          <input
            type="text"
            name="disease"
            placeholder="その他の場合は疾患名を入力してください"
            class="
              input input-secondary input-sm input-sm rounded-sm
              h-auto min-h-0 w-full max-w-xs
              px-2 py-2"
          >
        </label>
      </div>
    </div>

    <!-- 食生活 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">食生活</label>

      <p class="text-xs text-base-content/60 mb-2">
        ※ 該当する項目を選択してください（3つまで）
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% [
          "野菜が少ない",
          "炭水化物が多い",
          "脂っこいものが多い",
          "甘いものが多い",
          "バランスよく食べているバランスよく食べているバランスよく食べているバランスよく食べている",
          "野菜が少ない",
          "炭水化物が多い",
          "脂っこいものが多い",
          "甘いものが多い",
          "バランスよく食べている",
          "野菜が少ない",
          "炭水化物が多い",
          "脂っこいものが多い",
          "甘いものが多い",
          "バランスよく食べている"
        ].each do |diet| %>

          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="diet[]"
              value="<%= diet %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-sm rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= diet %>
            </div>
          </label>

        <% end %>

      </div>
    </div>

    <!-- 生活習慣 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">生活習慣</label>

      <p class="text-xs text-base-content/60 mb-2">
        ※ 該当する項目を選択してください（3つまで）
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% [
          "運動習慣が少ない",
          "デスクワークが多い",
          "活動量多め",
          "不規則な生活リズム",
          "夜勤がある",
          "料理が苦手",
          "お酒をよく飲む",
          "タバコを吸う"
        ].each do |lifestyle| %>

          <label class="cursor-pointer">
            <input
              type="checkbox"
              name="lifestyle[]"
              value="<%= lifestyle %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-sm rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= lifestyle %>
            </div>
          </label>

        <% end %>

      </div>
    </div>

    <!-- 性格傾向 -->
    <div class="mb-6">
      <label class="block mb-2 font-medium">食事療法に関する関心</label>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2">

        <% ["やりたくない","これからやってみたい","半年未満の継続あり","半年以上の継続あり"].each do |personality| %>
          <label class="cursor-pointer">
            <input
              type="radio"
              name="personality"
              value="<%= personality %>"
              class="peer hidden"
            >

            <div class="
              btn btn-outline btn-secondary btn-sm rounded-sm
              w-full min-w-0
              h-auto min-h-0
              flex items-center justify-center
              text-center
              whitespace-normal break-words
              px-2 py-2
              transition duration-150
              active:scale-98
              peer-checked:bg-secondary
              peer-checked:text-secondary-content
              peer-checked:border-secondary
            ">
              <%= personality %>
            </div>
          </label>
        <% end %>
      </div>
    </div>

  <p class="text-xs text-base-content/60 mt-2">
    ※ 情報が多いほど、より具体的なアドバイスになります
  </p>

    <%= submit_tag "アドバイスのヒントを確認",
      class: "w-full bg-blue-500 text-white py-2 rounded hover:bg-blue-600"
    %>

  <p class="text-xs text-base-content/60 mt-2">
    ※ AIが患者情報をもとにアドバイスのヒントを生成します。<br>
    ※ 最終的な判断は管理栄養士の専門的判断を優先してください。
  </p>
  <% end %>

  <div id="advice_result">
    <!-- AIリクエストの結果が表示される -->
  </div>
</section>